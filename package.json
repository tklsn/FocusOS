{
  "name": "@tklsn/FocusOS",
  "version": "0.1.0",
  "private": true,
  "description": "Gerenciador de tarefas offline-first",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "dev:desktop": "electron . --dev",
    "start:desktop": "nuxt build && electron .",
    "build:desktop": "nuxt build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.48.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "1.0.0-rc.4",
    "embla-carousel-vue": "^8.6.0",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.5",
    "shadcn-nuxt": "2.8.2",
    "tailwind-merge": "^3.7.0",
    "ulid": "^3.0.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.tklsn.focusos.app",
    "productName": "FocusOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".output",
        "to": "server"
      },
      {
        "from": "server/db/migrations",
        "to": "migrations"
      }
    ],
    "mac": {
      "target": "dmg",
      "identity": null,
      "category": "public.app-category.productivity"
    }
  }
}